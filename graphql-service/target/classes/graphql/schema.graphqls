type User {
    id: ID!
    name: String!
    email: String!
}

type Book {
    id: ID!
    title: String!
    author: String!
    price: Float!
}

type Order {
    id: ID!
    user: User!
    books: [Book!]!
    createdAt: String!
}

input CreateOrderInput {
    userId: ID!
    bookIds: [ID!]!
}

type Query {
    user(id: ID!): User
    books: [Book]
    order(id: ID!): Order
}

type Mutation {
    createOrder(input: CreateOrderInput!): Order
}
